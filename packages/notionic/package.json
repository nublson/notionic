{
  "name": "notionic",
  "version": "0.13.0",
  "description": "Render Notion API blocks as React Server Components, styled with Tailwind CSS and shadcn/ui tokens.",
  "license": "MIT",
  "author": "Nubelson Fernandes",
  "homepage": "https://notionic.dev",
  "bugs": "https://github.com/nublson/notionic/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nublson/notionic.git",
    "directory": "packages/notionic"
  },
  "keywords": [
    "notion",
    "notion-api",
    "notion-renderer",
    "react",
    "react-server-components",
    "nextjs",
    "tailwindcss",
    "shadcn",
    "cms",
    "blocks",
    "renderer"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./styles.css": {
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@notionhq/client": "^5.27.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "types": "./dist/index.d.ts"
}
